// Bucolish Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  phone             String              @unique
  email             String?             @unique
  password          String?
  name              String?
  role              String              @default("USER") // USER, ADMIN, BANNED, RESTRICTED
  intent            String?             // NEED_FLAT_AND_FLATMATE, HAVE_FLAT_NEED_FLATMATE, NEED_ROOM_ONLY, JUST_EXPLORING
  isOnboarded       Boolean             @default(false)
  avatar            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  profile           Profile?
  housingProfile    HousingProfile?
  lifestyleAnswers  LifestyleAnswer?
  preferences       Preference?
  verification      Verification?
  
  sentSwipes        Swipe[]             @relation("Swiper")
  receivedSwipes    Swipe[]             @relation("Target")
  
  matchesAsUser1    Match[]             @relation("User1")
  matchesAsUser2    Match[]             @relation("User2")
  
  messagesSent      Message[]
  reportsFiled      Report[]            @relation("Reporter")
  reportsReceived   Report[]            @relation("Reported")
  
  blocksInitiated   Block[]             @relation("Blocker")
  blocksReceived    Block[]             @relation("Blocked")
  
  notifications     Notification[]
}

model Profile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  age                Int?
  gender             String?     // MALE, FEMALE, NON_BINARY, OTHER
  occupation         String?
  company            String?
  bio                String?
  promptQuestion     String?
  promptAnswer       String?
  photos             String      // JSON array of photo URLs
  
  budgetMin          Int?
  budgetMax          Int?
  preferredCity      String      @default("Gurugram")
  preferredLocations String      // JSON array of sector names
  moveInDate         DateTime?
  leaseDuration      Int?        // in months
  
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model HousingProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title             String
  description       String
  photos            String      // JSON array of flat images
  city              String      @default("Gurugram")
  sector            String
  landmark          String?
  rent              Int
  deposit           Int
  flatType          String      // 1BHK, 2BHK, 3BHK, 4BHK, Studio
  furnishing        String      // Fully Furnished, Semi-Furnished, Unfurnished
  availableRoom     String      // Master Bedroom with attached washroom, Private Room, Shared Room
  totalFlatmates    Int
  availableFrom     DateTime
  amenities         String      // JSON array
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model LifestyleAnswer {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Cleanliness & Habits
  cleanlinessLevel  Int         // 1 to 5
  choresSharing     String      // Maid does everything, Equal rota, DIY as needed
  cookingHabit      String      // Cook daily, Order in / Meal service, Sometimes, Never
  
  // Schedule & Noise
  sleepSchedule     String      // Early bird (10pm - 6am), Night owl (2am - 10am), Flexible
  workArrangement   String      // WFH full-time, Hybrid, Work from office
  noiseTolerance    String      // Quiet zone, Moderate, Lively
  
  // Social Style
  guestComfort      String      // No overnight guests, Weekends only, Any time with notice, Very open
  partyHabit        String      // Never at home, Occasional gatherings, Weekend hosting
  
  // Values & Preferences
  smokingPreference String      // Strict non-smoker, Balcony smoker, Smoker friendly
  drinkingHabit     String      // Non-drinker, Social drinker, Regular
  petPreference     String      // Loves pets, No pets, Has a pet
  foodPreference    String      // Vegetarian, Non-Veg, Vegan, Any
  
  // Tag summary
  summaryTags       String      // JSON array of strings
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Preference {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  preferredGender   String      @default("ANY")
  minAge            Int         @default(18)
  maxAge            Int         @default(55)
  budgetMin         Int?
  budgetMax         Int?
  verifiedOnly      Boolean     @default(false)
  nonSmokerOnly     Boolean     @default(false)
  strictVegetarian  Boolean     @default(false)
  noPets            Boolean     @default(false)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Swipe {
  id                String      @id @default(cuid())
  swiperId          String
  targetId          String
  action            String      // PASS, LIKE, SUPER_LIKE
  createdAt         DateTime    @default(now())
  
  swiper            User        @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target            User        @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)
  
  @@unique([swiperId, targetId])
}

model Match {
  id                  String        @id @default(cuid())
  user1Id             String
  user2Id             String
  compatibilityScore  Int
  createdAt           DateTime      @default(now())
  
  user1               User          @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2               User          @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation        Conversation?
  
  @@unique([user1Id, user2Id])
}

model Conversation {
  id                 String      @id @default(cuid())
  matchId            String      @unique
  match              Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  user1ContactShared Boolean     @default(false)
  user2ContactShared Boolean     @default(false)
  
  messages           Message[]
  updatedAt          DateTime    @updatedAt
  createdAt          DateTime    @default(now())
}

model Message {
  id                String        @id @default(cuid())
  conversationId    String
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content           String
  msgType           String        @default("TEXT") // TEXT, CONTACT_SHARE, MEETUP_PROPOSAL, FLAT_CARD
  metaData          String?       // JSON string for rich card details
  isRead            Boolean       @default(false)
  createdAt         DateTime      @default(now())
}

model Verification {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phoneVerified     Boolean     @default(true)
  idVerified        String      @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  idDocType         String?     // AADHAAR, PASSPORT, DRIVING_LICENSE
  idDocUrl          String?
  
  workVerified      String      @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  workEmail         String?
  
  overallStatus     String      @default("PENDING")    // UNVERIFIED, PENDING, VERIFIED, REJECTED
  verifiedAt        DateTime?
  updatedAt         DateTime    @updatedAt
  createdAt         DateTime    @default(now())
}

model Report {
  id                String      @id @default(cuid())
  reporterId        String
  reporter          User        @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId        String
  reported          User        @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  
  reason            String      // SCAM, HARASSMENT, FAKE_PROFILE, INAPPROPRIATE, MONEY_REQUEST, OTHER
  description       String
  status            String      @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt         DateTime    @default(now())
}

model Block {
  id                String      @id @default(cuid())
  blockerId         String
  blocker           User        @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId         String
  blocked           User        @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  
  @@unique([blockerId, blockedId])
}

model Notification {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  body              String
  type              String      // MATCH, MESSAGE, VERIFICATION, SAFETY
  linkUrl           String?
  isRead            Boolean     @default(false)
  createdAt         DateTime    @default(now())
}
