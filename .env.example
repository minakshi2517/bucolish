# Environment variables for Bucolish Web App
DATABASE_URL="postgresql://user:password@localhost:5432/bucolish_db?schema=public" # Or file:./dev.db for SQLite
JWT_SECRET="replace_with_a_secure_random_jwt_secret_for_production"
NODE_ENV="production"

# External Integrations
NEXT_PUBLIC_APP_URL="https://bucolish.com"
OTP_MOCK_ENABLED="false"
SMS_PROVIDER_KEY="your_sms_gateway_api_key" # e.g. Twilio / Fast2SMS / AWS SNS
S3_STORAGE_BUCKET="bucolish-assets-prod"
S3_ACCESS_KEY_ID="your_s3_key_id"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
FIREBASE_SERVER_KEY="your_firebase_fcm_key_for_android_push"
